<Window x:Class="YuukaOCR.App.Ui.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization"
        Title="Yuuka" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="pack://application:,,,/YuukaOCR;component/Assets/app-icon.png"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Height" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True" ShowActivated="False" Opacity="0">

    <!-- Margin 22 = room for the DropShadowEffect (blur 18 + depth 3); without it the shadow is clipped at all four corners. -->
    <Border x:Name="Root" CornerRadius="12" Background="{DynamicResource YuukaBg}"
            BorderBrush="{DynamicResource YuukaBorder}" BorderThickness="1" Margin="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid Margin="12,9,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: drag handle + hint -->
            <Grid Grid.Row="0" Grid.Column="0" x:Name="HeaderRow" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseDown" MouseMove="OnHeaderMouseMove"
                  MouseLeftButtonUp="OnHeaderMouseUp">
                <TextBlock x:Name="HintText" Text="{ui:Tr result.hint}"
                           Foreground="{DynamicResource YuukaSubtle}"
                           FontFamily="{DynamicResource YuukaFontFamily}" FontSize="10"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <!-- right rail: close on top, copy at the bottom of the same column -->
            <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Margin="6,0,0,0" Width="20">
                <Button x:Name="CloseButton" Width="20" Height="12" Cursor="Hand"
                        HorizontalAlignment="Right" BorderThickness="0" Click="OnCloseClick"
                        ToolTip="{ui:Tr common.close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" CornerRadius="6" Background="{DynamicResource YuukaAccent}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CopyButton" Width="20" Height="20" Margin="0,8,0,0" Cursor="Hand"
                        HorizontalAlignment="Right" Click="OnCopyAllClick"
                        ToolTip="{ui:Tr result.copy}" Style="{StaticResource YuukaIconButton}">
                    <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource YuukaSubtle}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </StackPanel>

            <!-- OCR text: a read-only TextBox, because only a TextBox gives real text selection -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" MaxHeight="380" Margin="0,7,4,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="ResultBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         TextWrapping="Wrap" BorderThickness="0" Padding="0" Background="Transparent"
                         Foreground="{DynamicResource YuukaText}"
                         FontFamily="{DynamicResource YuukaFontFamily}"
                         FontSize="{DynamicResource YuukaFontSize}"
                         SelectionBrush="{DynamicResource YuukaAccent}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" />
            </ScrollViewer>

            <!-- conversation: only visible once the agent has said something -->
            <Border x:Name="AnswerPanel" Grid.Row="2" Grid.Column="0" Visibility="Collapsed"
                    Margin="0,7,4,0" Padding="8,6" CornerRadius="8"
                    Background="{DynamicResource YuukaPanel}" BorderThickness="0">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AnswerList" />
                </ScrollViewer>
            </Border>

            <!-- action bar: actions + chat, always one row -->
            <Grid Grid.Row="3" Grid.Column="0" Margin="0,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" MaxWidth="220" Margin="0,0,6,0">
                    <StackPanel x:Name="ActionBar" Orientation="Horizontal" />
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ScopeButton" Grid.Column="0" Height="26" Padding="7,0" Margin="0,0,5,0"
                            Cursor="Hand" Click="OnScopeClick" Style="{StaticResource YuukaChipButton}"
                            ToolTip="{ui:Tr result.context.scope}">
                        <TextBlock x:Name="ScopeText" Text="{ui:Tr result.context.all}" FontSize="10" />
                    </Button>

                    <!--
                        MinHeight, never Height: the placeholder was clipped along its bottom edge at 125 %
                        scaling because 24 DIP minus padding left less room than one line of text. The box
                        measures its own line and the row centres it against the 26 DIP buttons.
                    -->
                    <TextBox x:Name="ChatBox" Grid.Column="1" MinHeight="26" Padding="8,4" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" TextWrapping="NoWrap"
                             BorderThickness="0" Background="{DynamicResource YuukaPanel}"
                             Foreground="{DynamicResource YuukaText}"
                             FontFamily="{DynamicResource YuukaFontFamily}" FontSize="11"
                             CaretBrush="{DynamicResource YuukaText}"
                             KeyDown="OnChatKeyDown" GotKeyboardFocus="OnChatFocus" LostKeyboardFocus="OnChatBlur" />

                    <Button x:Name="SendButton" Grid.Column="2" Width="26" Height="26" Margin="5,0,0,0"
                            Cursor="Hand" Click="OnSendClick" ToolTip="{ui:Tr result.send}"
                            Style="{StaticResource YuukaAccentIconButton}">
                        <Path Data="{StaticResource IconSend}" Stroke="{DynamicResource YuukaOnAccent}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                    </Button>
                </Grid>
            </Grid>

            <!-- floating copy button: appears next to a selection, never inside the text flow -->
            <Popup x:Name="SelectionPopup" Placement="Relative"
                   AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Focusable="False">
                <Button x:Name="SelectionCopyButton" Width="26" Height="26" Cursor="Hand"
                        Click="OnCopySelectionClick" ToolTip="{ui:Tr result.copySelection}"
                        Style="{StaticResource YuukaAccentIconButton}">
                    <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource YuukaOnAccent}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                </Button>
            </Popup>
        </Grid>
    </Border>
</Window>
