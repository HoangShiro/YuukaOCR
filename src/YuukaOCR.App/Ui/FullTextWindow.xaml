<Window x:Class="YuukaOCR.App.Ui.FullTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization"
        Title="{ui:Tr fulltext.title}"
        Icon="pack://application:,,,/YuukaOCR;component/Assets/app-icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!-- Same shadow pad as the result bubble: the DropShadowEffect needs room or it is clipped. -->
    <Border x:Name="Chrome" CornerRadius="12" Background="{DynamicResource YuukaBg}"
            BorderBrush="{DynamicResource YuukaBorder}" BorderThickness="1" Margin="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Click="OnBack"
                        Style="{StaticResource YuukaButton}" Padding="10,5" Cursor="Hand"
                        ToolTip="{ui:Tr fulltext.backHint}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 6,0 L 0,5 L 6,10" Stroke="{DynamicResource YuukaText}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{ui:Tr fulltext.back}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,12,0"
                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource YuukaText}" VerticalAlignment="Center" />

                <Border x:Name="ReadOnlyBadge" Grid.Column="2" CornerRadius="8" Padding="8,3"
                        Background="{DynamicResource YuukaPanel}" Visibility="Collapsed">
                    <TextBlock Text="{ui:Tr fulltext.readOnly}" FontSize="11"
                               Foreground="{DynamicResource YuukaSubtle}" />
                </Border>
            </Grid>

            <!-- ============================================================== body -->
            <TextBox x:Name="EditorBox" Grid.Row="1" Margin="0,12,0,0"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top" Padding="10,8"
                     PreviewKeyDown="OnEditorKeyDown" />

            <!-- ============================================================ footer -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource YuukaSubtleText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="{ui:Tr fulltext.copy}" Click="OnCopy"
                            Style="{StaticResource YuukaButton}" Padding="12,5" Margin="0,0,8,0"
                            Cursor="Hand" Visibility="Collapsed" />
                    <Button x:Name="DoneButton" Content="{ui:Tr fulltext.done}" Click="OnDone"
                            Style="{StaticResource YuukaAccentButton}" Padding="16,5" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
