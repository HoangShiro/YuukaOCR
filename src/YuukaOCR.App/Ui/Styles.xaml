<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:YuukaOCR.App.Ui.Controls">

    <!-- Theme tokens. Theme.Apply() overwrites these per window; these are the fallbacks. -->
    <SolidColorBrush x:Key="YuukaBg" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="YuukaPanel" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="YuukaPanelHover" Color="#FF343434" />
    <SolidColorBrush x:Key="YuukaText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="YuukaSubtle" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="YuukaBorder" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="YuukaAccent" Color="#FFE98973" />
    <!-- Ink painted on top of an accent surface (accent buttons, selected tab); dark on light accents. -->
    <SolidColorBrush x:Key="YuukaOnAccent" Color="#FF14151A" />
    <SolidColorBrush x:Key="YuukaDanger" Color="#FFFF7A85" />
    <SolidColorBrush x:Key="YuukaBarBg" Color="#FFEAA2BC" />
    <SolidColorBrush x:Key="YuukaBarText" Color="#FF14151A" />
    <FontFamily x:Key="YuukaFontFamily">Segoe UI</FontFamily>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="YuukaFontSize">12</system:Double>

    <Style x:Key="YuukaTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="YuukaSubtleText" TargetType="TextBlock" BasedOn="{StaticResource YuukaTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource YuukaSubtle}" />
    </Style>

    <Style x:Key="YuukaHeaderText" TargetType="TextBlock" BasedOn="{StaticResource YuukaTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Small caption above a control that sits in a wrap panel (System → Connection). -->
    <Style x:Key="YuukaFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource YuukaSubtleText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ================= buttons ================= -->
    <Style x:Key="YuukaButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="Background" Value="{DynamicResource YuukaPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YuukaBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="YuukaAccentButton" TargetType="Button" BasedOn="{StaticResource YuukaButton}">
        <Setter Property="Background" Value="{DynamicResource YuukaAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource YuukaOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Icon-only button (API key list, result-window rail, history rows, action bar): square, no
         chrome until hovered, content is a Path/Viewbox. ONE definition only — a second resource with
         the same key is a runtime XAML crash ("Item has already been added"), never a build error. -->
    <Style x:Key="YuukaIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource YuukaSubtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= text input ================= -->
    <Style x:Key="YuukaTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="Background" Value="{DynamicResource YuukaPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YuukaBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource YuukaText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource YuukaAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource YuukaAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource YuukaTextBox}" />

    <Style x:Key="YuukaPasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="Background" Value="{DynamicResource YuukaPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YuukaBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource YuukaText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= checkbox ================= -->
    <Style x:Key="YuukaCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource YuukaPanel}"
                                BorderBrush="{DynamicResource YuukaBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 2,6 L 5.5,9.5 L 11,3" Stroke="{DynamicResource YuukaOnAccent}" StrokeThickness="2"
                                  Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource YuukaAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource YuukaAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource YuukaAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource YuukaCheckBox}" />

    <!-- ================= slider ================= -->
    <!--
        The template is hand-written, so TickPlacement would paint nothing (WPF only draws ticks when the
        template contains a TickBar). controls:TickMarks in the second row is that TickBar: one mark per
        TickFrequency plus its number. IsSnapToTickEnabled makes the slider discrete; each slider in the
        tabs sets its own TickFrequency.
    -->
    <Style x:Key="YuukaSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource YuukaAccent}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <!--
            No fixed Height: the thumb row is 20 DIP (an 18 DIP thumb needs the room — a 15 DIP row
            clipped the ellipse top and bottom) and the tick row measures itself. A hard-coded height
            is what cropped the thumb edge and, at 125 %, the tick labels too.
        -->
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 8 px track: 4 px was hard to hit with the mouse, especially at high DPI. -->
                        <Border Grid.Row="0" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource YuukaBorder}" />

                        <Track x:Name="PART_Track" Grid.Row="0" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="8" CornerRadius="4"
                                                    Background="{DynamicResource YuukaAccent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="8" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource YuukaAccent}"
                                                     Stroke="{DynamicResource YuukaBg}" StrokeThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <!-- Top-aligned with a small gap: the marks must start below the thumb, not under it. -->
                        <controls:TickMarks x:Name="PART_Ticks" Grid.Row="1" Inset="9"
                                            VerticalAlignment="Top" Margin="0,1,0,0"
                                            Minimum="{TemplateBinding Minimum}"
                                            Maximum="{TemplateBinding Maximum}"
                                            Step="{TemplateBinding TickFrequency}"
                                            Value="{TemplateBinding Value}"
                                            TickThickness="{Binding (controls:SliderTicks.Thickness), RelativeSource={RelativeSource TemplatedParent}}"
                                            TickBrush="{DynamicResource YuukaBorder}"
                                            PassedBrush="{DynamicResource YuukaAccent}"
                                            LabelBrush="{DynamicResource YuukaSubtle}"
                                            LabelFontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource YuukaSlider}" />

    <!-- ================= combo box ================= -->
    <Style x:Key="YuukaComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="Background" Value="{DynamicResource YuukaPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YuukaBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!--
                        Z-order matters:
                        Border (background) -> ToggleButton (catches the click that opens the dropdown) -> content.
                        With IsEditable=True, PART_EditableTextBox sits *on top* so it receives
                        clicks and keystrokes; the arrow area (last 20 px) still belongs to the ToggleButton.
                        A missing PART_EditableTextBox is why a ComboBox "cannot be typed into" even with
                        IsEditable=True — WPF silently ignores it and reports no error.
                    -->
                    <Grid>
                        <Border x:Name="Root" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />

                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Content" Grid.Column="0" IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                     Padding="0" Style="{x:Null}"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{DynamicResource YuukaAccent}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}" />

                            <Path Grid.Column="1" Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource YuukaSubtle}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource YuukaBg}" BorderBrush="{DynamicResource YuukaBorder}"
                                    BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource YuukaAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource YuukaAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource YuukaComboBox}" />

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5" Margin="3,1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= tabs ================= -->
    <Style x:Key="YuukaTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource YuukaPanel}" CornerRadius="9" Padding="4">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="0,10,0,0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource YuukaSubtle}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" CornerRadius="6" Padding="12,5" Margin="1,0" Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource YuukaOnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= scroll bar ================= -->
    <Style x:Key="YuukaScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{DynamicResource YuukaBorder}" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource YuukaScrollBarThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= list box ================= -->
    <Style x:Key="YuukaListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource YuukaBg}" BorderBrush="{DynamicResource YuukaBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource YuukaBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= icon buttons ================= -->
    <!--
        Icon-only buttons (result window, history rows, action bar) all share one template: a rounded
        square that tints on hover and dims on press. Geometry comes from Controls/ActionIcons.cs and is
        pasted into Data= below, so the shapes are shared with the code that builds buttons at runtime.
    -->
    <Geometry x:Key="IconCopy">M5.5,5.5 H13 V13.5 H5.5 Z M3,10.5 H2.5 V2.5 H10.5 V3</Geometry>
    <Geometry x:Key="IconSend">M2,8 L14,2 L10,14 L8,9.2 Z</Geometry>
    <Geometry x:Key="IconExpand">M6,2 H2 V6 M10,14 H14 V10 M2,2 L7,7 M14,14 L9,9</Geometry>
    <Geometry x:Key="IconCollapse">M7,7 L2,2 M2,6 V2 H6 M9,9 L14,14 M14,10 V14 H10</Geometry>
    <Geometry x:Key="IconRemove">M3,4.5 H13 M6.5,4.5 V2.8 H9.5 V4.5 M4.5,4.5 L5.2,13.5 H10.8 L11.5,4.5</Geometry>
    <Geometry x:Key="IconPlus">M8,3 V13 M3,8 H13</Geometry>
    <!-- Reset: the "restore default" arrow used by the prompt tool rows. -->
    <Geometry x:Key="IconReset">M2.34,10 A6,6 0 1 0 3.76,3.76 L0.67,6.67 M0.67,2.67 V6.67 H4.67</Geometry>
    <!-- Preset import/export: an arrow into / out of a tray. -->
    <Geometry x:Key="IconImport">M8,2 V10 M4.6,6.6 L8,10 L11.4,6.6 M2.5,13.2 H13.5</Geometry>
    <Geometry x:Key="IconExport">M8,10 V2 M4.6,5.4 L8,2 L11.4,5.4 M2.5,13.2 H13.5</Geometry>

    <!--
        Accent-filled icon button: the result window's send button, the floating copy buttons and the
        action-bar buttons. The glyph is painted with YuukaOnAccent, which is derived from the accent's
        own luminance — dark ink on the pastel accents of the light themes, light ink on the saturated
        accents of the dark ones. That is what makes the same button readable in both, instead of a
        transparent surface with dark ink disappearing on a dark bubble.
    -->
    <Style x:Key="YuukaAccentIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource YuukaAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource YuukaOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.62" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small text chip: the chat context toggle, browser-style tab labels, that sort of thing. -->
    <Style x:Key="YuukaChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource YuukaText}" />
        <!--
            The template paints {TemplateBinding Background}, so a caller can tint one chip (the selected
            action tab uses the accent). The default lives here instead of inside the template, where it
            used to swallow every Background a caller set.
        -->
        <Setter Property="Background" Value="{DynamicResource YuukaPanel}" />
        <Setter Property="FontFamily" Value="{DynamicResource YuukaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource YuukaFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource YuukaBorder}" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource YuukaPanelHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
