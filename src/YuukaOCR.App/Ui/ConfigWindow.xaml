<Window x:Class="YuukaOCR.App.Ui.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:YuukaOCR.App.Ui.Tabs"
        xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization"
        Title="{ui:Tr window.config.title}" Width="980" Height="720"
        Icon="pack://application:,,,/YuukaOCR;component/Assets/app-icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" ResizeMode="CanResize"
        MinWidth="820" MinHeight="580" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!-- Margin 30 = room for the DropShadowEffect (blur 24 + depth 4); without it the shadow is clipped at all four corners. -->
    <Border x:Name="Chrome" CornerRadius="14" Background="{DynamicResource YuukaBg}"
            BorderBrush="{DynamicResource YuukaBorder}" BorderThickness="1" Margin="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Margin="18,14,14,10" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource YuukaAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="YuukaOCR" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource YuukaText}"
                               FontFamily="{DynamicResource YuukaFontFamily}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Margin="8,2,0,0" FontSize="11"
                               Foreground="{DynamicResource YuukaSubtle}"
                               FontFamily="{DynamicResource YuukaFontFamily}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="CloseButton" Width="28" Height="28" Cursor="Hand"
                        Click="OnCloseClick" ToolTip="{ui:Tr common.close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource YuukaPanel}">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource YuukaText}"
                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FFE9739E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource YuukaTabControl}"
                        Margin="16,0,16,16">
                <TabItem Header="{ui:Tr tab.system}">
                    <tabs:SystemTab x:Name="SystemPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.ui}">
                    <tabs:ThemeTab x:Name="ThemePanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.layout}">
                    <tabs:LayoutTab x:Name="LayoutPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.hooking}">
                    <tabs:HookingTab x:Name="HookingPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.agent}">
                    <tabs:PromptAgentTab x:Name="PromptPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.log}">
                    <tabs:LogTab x:Name="LogPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.status}">
                    <tabs:StatusTab x:Name="StatusPanel" />
                </TabItem>
                <TabItem Header="{ui:Tr tab.console}">
                    <tabs:ConsoleTab x:Name="ConsolePanel" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
