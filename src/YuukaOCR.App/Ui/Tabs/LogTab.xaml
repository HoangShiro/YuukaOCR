<UserControl x:Class="YuukaOCR.App.Ui.Tabs.LogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- recent results and prompts used share one row, side by side -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{ui:Tr log.recent}" Style="{StaticResource YuukaHeaderText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{ui:Tr common.refresh}" Click="OnRefresh"
                            Style="{StaticResource YuukaButton}" Padding="9,3" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{ui:Tr common.clear}" Click="OnClearOutputs"
                            Style="{StaticResource YuukaButton}" Padding="9,3" />
                </Grid>

                <ScrollViewer x:Name="OutputScroll" Grid.Row="1" Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OutputList" />
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{ui:Tr log.prompts}" Style="{StaticResource YuukaHeaderText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{ui:Tr common.clear}" Click="OnClearPrompts"
                            Style="{StaticResource YuukaButton}" Padding="9,3" />
                </Grid>

                <ScrollViewer x:Name="PromptScroll" Grid.Row="1" Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PromptList" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- the action bar's conversation, in order -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr log.chat}" Style="{StaticResource YuukaHeaderText}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{ui:Tr common.clear}" Click="OnClearChat"
                        Style="{StaticResource YuukaButton}" Padding="9,3" />
            </Grid>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="0,6,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChatList" />
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Style="{StaticResource YuukaSubtleText}"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
    </Grid>
</UserControl>
