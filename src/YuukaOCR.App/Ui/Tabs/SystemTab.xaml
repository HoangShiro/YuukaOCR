<UserControl x:Class="YuukaOCR.App.Ui.Tabs.SystemTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuukaOCR.App.Ui.Controls"
             xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <TextBlock Text="{ui:Tr sys.connection}" Style="{StaticResource YuukaHeaderText}" />

            <!--
                Provider / Base URL / Model share one row. A WrapPanel is what makes "one row" safe: as
                soon as the window is narrow or the UI font is large, the fields drop onto extra lines
                instead of squeezing each other to nothing.
            -->
            <WrapPanel>
                <StackPanel Width="220" Margin="0,0,12,8">
                    <TextBlock Text="{ui:Tr sys.provider}" Style="{StaticResource YuukaFieldLabel}" />
                    <ComboBox x:Name="ProviderCombo" SelectionChanged="OnProviderChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="250" Margin="0,0,12,8">
                    <TextBlock Text="{ui:Tr sys.baseUrl.label}" Style="{StaticResource YuukaFieldLabel}" />
                    <TextBox x:Name="BaseUrlBox" LostFocus="OnBaseUrlLostFocus" />
                </StackPanel>

                <StackPanel Width="330" Margin="0,0,0,8">
                    <TextBlock Text="{ui:Tr sys.model}" Style="{StaticResource YuukaFieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ModelPicker x:Name="ModelPicker" />
                        <Button Grid.Column="1" x:Name="RefreshModelsButton" Content="{ui:Tr common.refresh}"
                                Margin="8,0,0,0" Click="OnRefreshModels" Style="{StaticResource YuukaButton}" />
                    </Grid>
                </StackPanel>
            </WrapPanel>

            <TextBlock x:Name="ProviderNote" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap"
                       Margin="0,2,0,0" />
            <TextBlock Text="{ui:Tr sys.baseUrl}" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock x:Name="ModelHint" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="{ui:Tr sys.model.hint}" />
            <!-- State of the model list itself: loading / "N models" / why it is empty. -->
            <TextBlock x:Name="ModelStatus" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap"
                       Margin="0,2,0,0" />

            <Separator />

            <TextBlock Text="{ui:Tr sys.apiKey}" Style="{StaticResource YuukaHeaderText}" />
            <TextBlock x:Name="KeyHint" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap" />

            <!-- Startup check: shown when the provider has no key at all, or the stored one was rejected. -->
            <TextBlock x:Name="KeyPrompt" Style="{StaticResource YuukaSubtleText}"
                       Foreground="{DynamicResource YuukaDanger}" TextWrapping="Wrap"
                       Margin="0,4,0,2" Visibility="Collapsed" />

            <!-- One row per stored key: the masked value plus icon-only Copy / Remove. -->
            <ListBox x:Name="KeyList" Style="{StaticResource YuukaListBox}" MaxHeight="132" Margin="0,6,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Masked}" VerticalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{DynamicResource YuukaText}"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="1" Style="{StaticResource YuukaIconButton}" Click="OnCopyKey"
                                    ToolTip="{ui:Tr sys.key.copy}" Margin="6,0,0,0">
                                <Path Data="M 4.5,0.5 H 11.5 V 7.5 H 9.5 M 0.5,4.5 H 7.5 V 11.5 H 0.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" StrokeLineJoin="Round" />
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource YuukaIconButton}" Click="OnRemoveKey"
                                    ToolTip="{ui:Tr sys.key.removeOne}" Margin="2,0,0,0">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="KeyEmpty" Text="{ui:Tr sys.key.none}" Style="{StaticResource YuukaSubtleText}"
                       Margin="2,4,0,0" Visibility="Collapsed" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="KeyBox" Style="{StaticResource YuukaPasswordBox}" />
                <Button Grid.Column="1" x:Name="AddKeyButton" Content="{ui:Tr sys.key.add}" MinWidth="84"
                        Margin="8,0,0,0" Click="OnAddKey" Style="{StaticResource YuukaAccentButton}" />
            </Grid>

            <!-- Sits directly under the input: a rejected key must not be reported somewhere else. -->
            <TextBlock x:Name="KeyError" Style="{StaticResource YuukaSubtleText}"
                       Foreground="{DynamicResource YuukaDanger}" TextWrapping="Wrap"
                       Margin="0,5,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="KeyStatus" Style="{StaticResource YuukaSubtleText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <Separator />

            <TextBlock Text="{ui:Tr sys.hotkey}" Style="{StaticResource YuukaHeaderText}" />
            <controls:HotkeyBox x:Name="HotkeyControl" />
            <TextBlock Style="{StaticResource YuukaSubtleText}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="{ui:Tr sys.hotkey.hint}" />

            <Separator />

            <TextBlock Text="{ui:Tr sys.behaviour}" Style="{StaticResource YuukaHeaderText}" />
            <CheckBox x:Name="StartWithSystemBox" Content="{ui:Tr sys.startWithWindows}"
                      Checked="OnStartWithSystem" Unchecked="OnStartWithSystem" Margin="0,2" />
            <CheckBox x:Name="AutoUpdateBox" Content="{ui:Tr sys.autoUpdate}"
                      Checked="OnAutoUpdate" Unchecked="OnAutoUpdate" Margin="0,2" />
            <CheckBox x:Name="ProcessTextBox" Content="{ui:Tr sys.processText}"
                      Checked="OnClipboardOption" Unchecked="OnClipboardOption" Margin="0,2" />
            <CheckBox x:Name="ProcessImageBox" Content="{ui:Tr sys.processImage}"
                      Checked="OnClipboardOption" Unchecked="OnClipboardOption" Margin="0,2" />
            <CheckBox x:Name="ProcessFileBox" Content="{ui:Tr sys.processFile}"
                      Checked="OnClipboardOption" Unchecked="OnClipboardOption" Margin="0,2" />

            <Separator />

            <!-- The OCR prompt moved to Settings → Prompt/Agent (it grew a whole tab of its own). -->

            <StackPanel Orientation="Horizontal">
                <Button x:Name="UpdateButton" Content="{ui:Tr sys.checkUpdate}" Click="OnCheckUpdate"
                        Style="{StaticResource YuukaButton}" />
                <Button Content="{ui:Tr sys.openUser}" Margin="8,0,0,0" Click="OnOpenUserFolder"
                        Style="{StaticResource YuukaButton}" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource YuukaSubtleText}" Margin="0,8,0,4"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
