<UserControl x:Class="YuukaOCR.App.Ui.Tabs.ThemeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <TextBlock Text="{ui:Tr ui.language}" Style="{StaticResource YuukaHeaderText}" />
            <ComboBox x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" />
            <TextBlock Text="{ui:Tr ui.language.hint}" Style="{StaticResource YuukaSubtleText}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <Separator />

            <!-- Preset cards are built in code: one per row of ThemePresets.All. -->
            <TextBlock Text="{ui:Tr ui.theme}" Style="{StaticResource YuukaHeaderText}" />
            <TextBlock Text="{ui:Tr ui.theme.hint}" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap" />
            <WrapPanel x:Name="PresetPanel" Margin="0,10,0,0" />

            <Separator />

            <TextBlock Text="{ui:Tr ui.opacity}" Style="{StaticResource YuukaHeaderText}" />
            <TextBlock Text="{ui:Tr ui.opacity.hint}" Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr ui.opacity.frame}" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource YuukaTextStyle}" />
                <Slider x:Name="FrameOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"
                        TickFrequency="10" ValueChanged="OnFrameOpacityChanged" />
                <TextBlock x:Name="FrameOpacityValue" Grid.Column="2" TextAlignment="Right" Margin="0,6,0,0"
                           VerticalAlignment="Top" Style="{StaticResource YuukaSubtleText}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr ui.opacity.background}" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource YuukaTextStyle}" />
                <Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"
                        TickFrequency="10" ValueChanged="OnBackgroundOpacityChanged" />
                <TextBlock x:Name="BackgroundOpacityValue" Grid.Column="2" TextAlignment="Right" Margin="0,6,0,0"
                           VerticalAlignment="Top" Style="{StaticResource YuukaSubtleText}" />
            </Grid>

            <Separator />

            <TextBlock Text="{ui:Tr ui.font}" Style="{StaticResource YuukaHeaderText}" />
            <ComboBox x:Name="FontCombo" SelectionChanged="OnFontChanged" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr ui.fontSize}" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource YuukaTextStyle}" />
                <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="8" Maximum="32" TickFrequency="4"
                        ValueChanged="OnFontSizeChanged" />
                <TextBlock x:Name="FontSizeValue" Grid.Column="2" TextAlignment="Right" Margin="0,6,0,0"
                           VerticalAlignment="Top" Style="{StaticResource YuukaSubtleText}" />
            </Grid>

            <Separator />

            <TextBlock Text="{ui:Tr ui.barImage}" Style="{StaticResource YuukaHeaderText}" />
            <TextBlock Style="{StaticResource YuukaSubtleText}" TextWrapping="Wrap"
                       Text="{ui:Tr ui.barImage.hint}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{ui:Tr ui.barImage.pick}" Click="OnPickImage" Style="{StaticResource YuukaButton}" />
                <Button Content="{ui:Tr ui.barImage.default}" Margin="8,0,0,0" Click="OnResetImage"
                        Style="{StaticResource YuukaButton}" />
            </StackPanel>
            <TextBlock x:Name="ImageStatus" Style="{StaticResource YuukaSubtleText}" Margin="0,6,0,0" />

            <Separator />

            <TextBlock Text="{ui:Tr ui.scale}" Style="{StaticResource YuukaHeaderText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr ui.scale.percent}" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource YuukaTextStyle}" />
                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="50" Maximum="200" TickFrequency="25"
                        ValueChanged="OnScaleChanged" />
                <TextBlock x:Name="ScaleValue" Grid.Column="2" TextAlignment="Right" Margin="0,6,0,0"
                           VerticalAlignment="Top" Style="{StaticResource YuukaSubtleText}" />
            </Grid>

            <Button Content="{ui:Tr ui.reset}" Margin="0,16,0,0" Click="OnResetTheme"
                    Style="{StaticResource YuukaButton}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
