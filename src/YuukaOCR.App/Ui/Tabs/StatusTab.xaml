<UserControl x:Class="YuukaOCR.App.Ui.Tabs.StatusTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Tr status.title}" Style="{StaticResource YuukaHeaderText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{ui:Tr common.refresh}" Click="OnRefresh" Style="{StaticResource YuukaButton}"
                        Padding="10,3" />
            </Grid>

            <Border Background="{DynamicResource YuukaPanel}" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="ProviderLine" Style="{StaticResource YuukaTextStyle}" />
                    <TextBlock x:Name="HotkeyLine" Style="{StaticResource YuukaSubtleText}" Margin="0,4,0,0" />
                    <TextBlock x:Name="HookLine" Style="{StaticResource YuukaSubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{ui:Tr status.api}" Style="{StaticResource YuukaHeaderText}" Margin="0,16,0,0" />
            <Border Background="{DynamicResource YuukaPanel}" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="ApiTotalLine" Style="{StaticResource YuukaTextStyle}" />
                    <TextBlock x:Name="ApiModelsLine" Style="{StaticResource YuukaSubtleText}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{ui:Tr status.runtime}" Style="{StaticResource YuukaHeaderText}" Margin="0,16,0,0" />
            <Border Background="{DynamicResource YuukaPanel}" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="RuntimeTotalLine" Style="{StaticResource YuukaTextStyle}" />
                    <TextBlock x:Name="RuntimeTodayLine" Style="{StaticResource YuukaSubtleText}" Margin="0,4,0,0" />
                    <TextBlock x:Name="RuntimeSessionLine" Style="{StaticResource YuukaSubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{ui:Tr status.sources}" Style="{StaticResource YuukaHeaderText}" Margin="0,16,0,0" />
            <Border Background="{DynamicResource YuukaPanel}" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="SourceLine" Style="{StaticResource YuukaTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="FileDropLine" Style="{StaticResource YuukaSubtleText}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
