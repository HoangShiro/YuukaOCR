<UserControl x:Class="YuukaOCR.App.Ui.Controls.PromptTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:YuukaOCR.App.Ui.Localization">
    <!--
        The two icon-only buttons every prompt field carries: expand into the Full Text Edit Mode, and
        restore the shipped default. One control for all of them — the OCR prompt, the agent instruction
        and each action's instruction use exactly this.
    -->
    <StackPanel Orientation="Horizontal">
        <Button x:Name="ExpandButton" Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand"
                Click="OnExpand" ToolTip="{ui:Tr prompt.expand}"
                Style="{StaticResource YuukaIconButton}">
            <Path Data="{StaticResource IconExpand}" Stroke="{DynamicResource YuukaText}"
                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="Uniform" Width="12" Height="12" />
        </Button>
        <Button x:Name="ResetButton" Width="26" Height="26" Cursor="Hand"
                Click="OnReset" ToolTip="{ui:Tr prompt.reset}"
                Style="{StaticResource YuukaIconButton}">
            <Path Data="{StaticResource IconReset}" Stroke="{DynamicResource YuukaText}"
                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="Uniform" Width="13" Height="13" />
        </Button>
    </StackPanel>
</UserControl>
